# Unversioned filenames must revalidate; do not mark them immutable.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

/sw.js
  Cache-Control: no-store

/nuvio.env.js
  Cache-Control: no-store

# Opt-in plugin engine assets (issue #11). The manifest is not immutable; the
# content-versioned directory is. Rules are inert when no engine assets exist.
/assets/plugins/plugin-engine.json
  Cache-Control: no-store
  Content-Type: application/json

/assets/plugins/*/plugin-engine.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/javascript; charset=utf-8
  X-Content-Type-Options: nosniff

/assets/plugins/*/emscripten-module.wasm
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm
  X-Content-Type-Options: nosniff
