# Unversioned filenames must revalidate; do not mark them immutable.
#
# Content-Security-Policy (issue #224). No inline script anywhere: boot checks
# live in boot-guard.js and image fallbacks in js/ui/imageFallback.js.
#   script-src   own files; 'wasm-unsafe-eval' for the bitmap subtitle decoder;
#                the two pinned CDN fallbacks of the streaming libraries.
#   style-src    'unsafe-inline' because templates set style="" attributes.
#   connect-src  user add-ons and APIs on any https host; a local streaming
#                server or proxy on localhost over http.
#   img/media    any https artwork and stream, blob: for offline files and
#                playlists, data: for cached logos and QR codes.
#   frame-src    YouTube trailers.
# The plugin worker gets its own policy below: it alone may eval plugin code.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/hls.js@1.5.20/ https://cdn.jsdelivr.net/npm/dashjs@4.7.4/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' https: data: blob:; media-src 'self' https: data: blob: http://localhost:* http://127.0.0.1:*; connect-src 'self' https: wss: data: blob: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; child-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

/sw.js
  Cache-Control: no-store

/nuvio.env.js
  Cache-Control: no-store

# Plugins are user-installed scraper code run with new Function inside this
# dedicated worker. A worker loaded from a URL is governed by the policy on its
# own response, so 'unsafe-eval' is granted here and nowhere else.
/plugin-worker.bundle.js
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src https: http://localhost:* http://127.0.0.1:*
