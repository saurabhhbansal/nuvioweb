{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvioweb.example/schemas/upstream-report-v1.json",
  "title": "NuvioWeb upstream observation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectSha", "stateSha256", "generatedAt", "status", "sources", "findings", "errors", "limits", "fingerprint"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectSha": { "$ref": "#/$defs/sha40" },
    "stateSha256": { "$ref": "#/$defs/sha256" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["complete", "partial", "error"] },
    "sources": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/source" }
    },
    "findings": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/finding" } },
    "errors": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/error" } },
    "limits": { "$ref": "#/$defs/limits" },
    "fingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "ref", "enabled", "refs", "comparisons", "files", "tags", "releases", "license", "parity"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$" },
        "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "ref": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,128}$" },
        "enabled": { "type": "boolean" },
        "refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["import", "reviewed", "observed"],
          "properties": { "import": { "$ref": "#/$defs/nullSha" }, "reviewed": { "$ref": "#/$defs/nullSha" }, "observed": { "$ref": "#/$defs/nullSha" } }
        },
        "comparisons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relationship", "complete"],
          "properties": {
            "relationship": { "enum": ["identical", "ahead", "behind", "diverged", "unknown"] },
            "aheadBy": { "type": "integer", "minimum": 0 },
            "behindBy": { "type": "integer", "minimum": 0 },
            "complete": { "type": "boolean" },
            "commits": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/sha40" } }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "truncated"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "samples": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 512 } }
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed", "retargeted"],
          "properties": {
            "added": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 128 } },
            "removed": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 128 } },
            "retargeted": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["name", "from", "to"], "properties": { "name": { "type": "string", "maxLength": 128 }, "from": { "$ref": "#/$defs/nullSha" }, "to": { "$ref": "#/$defs/sha40" } } } }
          }
        },
        "releases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed", "changed"],
          "properties": {
            "added": { "type": "array", "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["id", "tagName"], "properties": { "id": { "type": "integer", "minimum": 1 }, "tagName": { "type": "string", "maxLength": 128 } } } },
            "removed": { "type": "array", "maxItems": 100, "items": { "type": "integer", "minimum": 1 } },
            "changed": { "type": "array", "maxItems": 100, "items": { "type": "integer", "minimum": 1 } }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "findings"],
          "properties": {
            "status": { "enum": ["tracked-notices-unchanged", "drift-detected", "missing-required-license", "unknown"] },
            "findings": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 512 } }
          }
        },
        "parity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matched", "unresolved"],
          "properties": {
            "matched": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 128 } },
            "unresolved": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 128 } }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "severity", "evidence", "reviewRequired"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
        "kind": { "enum": ["critical-bugfix-candidate", "compatible-feature-candidate", "incompatible-change-candidate", "native-only-candidate", "browser-no-op-candidate", "unclassified", "license-drift", "health"] },
        "severity": { "enum": ["info", "review", "warning"] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "maxLength": 512 } },
        "reviewRequired": { "const": true }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "operation", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9-]{2,64}$" },
        "operation": { "type": "string", "maxLength": 128 },
        "retryable": { "type": "boolean" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "bytes", "truncated"],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "capsReached": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 64 } }
      }
    }
  }
}
